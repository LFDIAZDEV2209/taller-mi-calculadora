Algoritmo MiCalculadora

    // ============================================================
    // TALLER "MI CALCULADORA"
    // Estructuras de Datos - PSeInt
    // ============================================================

    // ============================================================
    // PASO I - DECLARACION DE ARREGLOS Y VARIABLES
    // ============================================================

    Definir numeros Como Real
    Definir resultados Como Real

    Definir nombresOperacion Como Cadena
    Definir simboloOperacion Como Cadena
    Definir operaciones Como Cadena
    Definir estadoOperacion Como Cadena

    Dimension numeros[6]
    Dimension nombresOperacion[5]
    Dimension simboloOperacion[5]
    Dimension operaciones[5]
    Dimension resultados[5]
    Dimension estadoOperacion[5]

    // Variables auxiliares

    Definir cantidad Como Entero
    Definir i Como Entero
    Definir j Como Entero
    Definir k Como Entero
    Definir opcion Como Entero
    Definir codigo Como Entero
    Definir operacionesConError Como Entero

    Definir numeroIngresado Como Real
    Definir acumulado Como Real

    Definir datoValido Como Logico
    Definir divisorEnCero Como Logico

    Definir entrada Como Cadena

    // ============================================================
    // TITULO DEL PROGRAMA
    // ============================================================

    Escribir "========================================================"
    Escribir "             MI CALCULADORA - TALLER ARREGLOS"
    Escribir "            Estructuras de Datos - PSeInt"
    Escribir "========================================================"
    Escribir ""

    // ============================================================
    // PASO II - SOLICITAR LOS NUMEROS
    // ============================================================

    Repetir

        Escribir "Cuantos numeros desea operar (entre 2 y 5)?: "
        Leer cantidad

        Si cantidad < 2 O cantidad > 5 Entonces

            Escribir ""
            Escribir "========================================================"
            Escribir "ERROR: LA CANTIDAD DEBE ESTAR ENTRE 2 Y 5"
            Escribir "========================================================"
            Escribir ""

            // Pausa para tomar captura
            Esperar 30 Segundos

        FinSi

    Hasta Que cantidad >= 2 Y cantidad <= 5

    // ------------------------------------------------------------
    // Solicitar cada numero y validarlo
    // ------------------------------------------------------------

    Para i <- 1 Hasta cantidad Hacer

        datoValido <- Falso

        Mientras datoValido = Falso Hacer

            Escribir "Ingrese el numero ", i, " de ", cantidad, ": "
            Leer entrada

            Si EsNumeroValido(entrada) Entonces

                numeroIngresado <- ConvertirANumero(entrada)
                datoValido <- Verdadero

            Sino

                Escribir ""
                Escribir "========================================================"
                Escribir "ERROR: ENTRADA INVALIDA"
                Escribir "Ingrese solamente numeros."
                Escribir "Ejemplos validos: -12, 3.5, 10"
                Escribir "========================================================"
                Escribir ""

                // PAUSA PARA PODER TOMAR LA CAPTURA 08
                Esperar 30 Segundos

            FinSi

        FinMientras

        numeros[i] <- numeroIngresado

    FinPara

    // ------------------------------------------------------------
    // Mostrar contenido del arreglo numeros
    // ------------------------------------------------------------

    Escribir ""
    Escribir "========================================================"
    Escribir "           CONTENIDO DEL ARREGLO numeros"
    Escribir "========================================================"

    Para i <- 1 Hasta cantidad Hacer

        Escribir "numeros[", i, "] = ", numeros[i]

    FinPara

    Escribir ""

    // ============================================================
    // PASO III - ARREGLO DE OPERACIONES
    // ============================================================

    nombresOperacion[1] <- "SUMA"
    nombresOperacion[2] <- "RESTA"
    nombresOperacion[3] <- "MULTIPLICACION"
    nombresOperacion[4] <- "DIVISION"

    simboloOperacion[1] <- "+"
    simboloOperacion[2] <- "-"
    simboloOperacion[3] <- "*"
    simboloOperacion[4] <- "/"

    Escribir "========================================================"
    Escribir "              OPERACIONES DISPONIBLES"
    Escribir "========================================================"

    Para i <- 1 Hasta 4 Hacer

        Escribir "Opcion ", i, ": ", nombresOperacion[i], " (", simboloOperacion[i], ")"

    FinPara

    Escribir ""

    // ============================================================
    // PASO IV - SELECCIONAR LAS OPERACIONES
    // ============================================================

    Escribir "========================================================"
    Escribir "        PASO IV - SELECCION DE OPERACIONES"
    Escribir "========================================================"
    Escribir ""

    Escribir "Seleccione las 4 operaciones que desea realizar."

    Para j <- 1 Hasta 4 Hacer

        Repetir

            Escribir ""
            Escribir "Seleccion numero ", j, " de 4"
            Escribir "----------------------------------------"
            Escribir "1. SUMA (+)"
            Escribir "2. RESTA (-)"
            Escribir "3. MULTIPLICACION (*)"
            Escribir "4. DIVISION (/)"
            Escribir "----------------------------------------"
            Escribir "Opcion elegida:"

            Leer opcion

            Si opcion < 1 O opcion > 4 Entonces

                Escribir ""
                Escribir "========================================================"
                Escribir "ERROR: OPCION INVALIDA"
                Escribir "Digite un numero entre 1 y 4."
                Escribir "========================================================"
                Escribir ""

                // Pausa para tomar captura del error
                Esperar 30 Segundos

            FinSi

        Hasta Que opcion >= 1 Y opcion <= 4

        operaciones[j] <- nombresOperacion[opcion]

        Escribir ""
        Escribir "Registro realizado:"
        Escribir "operaciones[", j, "] = ", operaciones[j]

    FinPara

    // ------------------------------------------------------------
    // Mostrar las operaciones almacenadas
    // ------------------------------------------------------------

    Escribir ""
    Escribir "========================================================"
    Escribir "        OPERACIONES ALMACENADAS EN EL ARREGLO"
    Escribir "========================================================"

    Para j <- 1 Hasta 4 Hacer

        Escribir "operaciones[", j, "] = ", operaciones[j]

    FinPara

    // ============================================================
    // PASO V - RECORRER EL ARREGLO DE OPERACIONES
    // PASO VI - EJECUTAR CADA OPERACION
    // ============================================================

    Escribir ""
    Escribir "========================================================"
    Escribir "       PASOS V Y VI - PROCESANDO OPERACIONES"
    Escribir "========================================================"
    Escribir ""

    Escribir "Procesando el arreglo operaciones con el lazo Para..."

    Para k <- 1 Hasta 4 Hacer

        // --------------------------------------------------------
        // Buscar el codigo correspondiente a la operacion
        // --------------------------------------------------------

        codigo <- 0

        Para j <- 1 Hasta 4 Hacer

            Si operaciones[k] = nombresOperacion[j] Entonces

                codigo <- j

            FinSi

        FinPara

        // --------------------------------------------------------
        // PASO VI - Ejecutar operacion mediante SEGUN
        // --------------------------------------------------------

        Segun codigo Hacer

            1:

                // ================================================
                // SUMA
                // ================================================

                acumulado <- numeros[1]

                Para j <- 2 Hasta cantidad Hacer

                    acumulado <- acumulado + numeros[j]

                FinPara

                resultados[k] <- acumulado
                estadoOperacion[k] <- "CORRECTA"

            2:

                // ================================================
                // RESTA
                // ================================================

                acumulado <- numeros[1]

                Para j <- 2 Hasta cantidad Hacer

                    acumulado <- acumulado - numeros[j]

                FinPara

                resultados[k] <- acumulado
                estadoOperacion[k] <- "CORRECTA"

            3:

                // ================================================
                // MULTIPLICACION
                // ================================================

                acumulado <- 1

                Para j <- 1 Hasta cantidad Hacer

                    acumulado <- acumulado * numeros[j]

                FinPara

                resultados[k] <- acumulado
                estadoOperacion[k] <- "CORRECTA"

            4:

                // ================================================
                // DIVISION
                // ================================================

                divisorEnCero <- Falso

                // Verificar si existe un divisor igual a cero

                Para j <- 2 Hasta cantidad Hacer

                    Si numeros[j] = 0 Entonces

                        divisorEnCero <- Verdadero

                    FinSi

                FinPara

                Si divisorEnCero Entonces

                    resultados[k] <- 0
                    estadoOperacion[k] <- "ERROR: NO SE PUEDE DIVIDIR ENTRE CERO"

                Sino

                    acumulado <- numeros[1]

                    Para j <- 2 Hasta cantidad Hacer

                        acumulado <- acumulado / numeros[j]

                    FinPara

                    resultados[k] <- acumulado
                    estadoOperacion[k] <- "CORRECTA"

                FinSi

            De Otro Modo:

                resultados[k] <- 0
                estadoOperacion[k] <- "ERROR: OPERACION NO RECONOCIDA"

        FinSegun

    FinPara

    // ============================================================
    // PASO VII - MOSTRAR LOS RESULTADOS
    // ============================================================

    Escribir ""
    Escribir "========================================================"
    Escribir "       PASO VII - RESULTADOS DE LAS OPERACIONES"
    Escribir "========================================================"

    operacionesConError <- 0

    Para k <- 1 Hasta 4 Hacer

        Escribir ""
        Escribir "Operacion ", k, " -> ", operaciones[k]

        Si estadoOperacion[k] = "CORRECTA" Entonces

            Escribir "   Resultado = ", resultados[k]

        Sino

            Escribir "   ", estadoOperacion[k]

            operacionesConError <- operacionesConError + 1

        FinSi

    FinPara

    // ============================================================
    // RESUMEN
    // ============================================================

    Escribir ""
    Escribir "--------------------------------------------------------"
    Escribir "                 RESUMEN DE EJECUCION"
    Escribir "--------------------------------------------------------"

    Escribir "Operaciones registradas              : 4"
    Escribir "Operaciones ejecutadas correctamente : ", 4 - operacionesConError
    Escribir "Operaciones con error                : ", operacionesConError

    Escribir "--------------------------------------------------------"

    // ============================================================
    // HISTORIAL FINAL
    // ============================================================

    Escribir ""
    Escribir "========================================================"
    Escribir "             HISTORIAL DE OPERACIONES"
    Escribir "========================================================"

    Para k <- 1 Hasta 4 Hacer

        Escribir ""
        Escribir "[", k, "] ", operaciones[k]
        Escribir "    Resultado : ", resultados[k]
        Escribir "    Estado    : ", estadoOperacion[k]

    FinPara

    Escribir ""
    Escribir "========================================================"
    Escribir "       FIN DE LA EJECUCION DE MI CALCULADORA"
    Escribir "========================================================"
    Escribir ""
    Escribir "La ventana permanecera abierta durante 30 segundos."
    Escribir "Puede tomar la captura de pantalla ahora."

    // Pausa final para poder tomar captura
    Esperar 30 Segundos

FinAlgoritmo

// ============================================================
// FUNCION AUXILIAR
// Comprueba si la entrada representa un numero valido
// ============================================================

Funcion resultado <- EsNumeroValido(texto)

    Definir longitudTexto Como Entero
    Definir posicion Como Entero
    Definir j Como Entero
    Definir cantidadPuntos Como Entero
    Definir cantidadDigitos Como Entero

    Definir hayError Como Logico
    Definir esDigito Como Logico

    Definir caracter Como Cadena
    Definir digitosValidos Como Cadena

    digitosValidos <- "0123456789"

    longitudTexto <- Longitud(texto)

    cantidadPuntos <- 0
    cantidadDigitos <- 0

    hayError <- Falso

    posicion <- 0

    // ------------------------------------------------------------
    // Una entrada vacia no es valida
    // ------------------------------------------------------------

    Si longitudTexto = 0 Entonces

        hayError <- Verdadero

    FinSi

    // ------------------------------------------------------------
    // Se permite signo negativo solamente al principio
    // ------------------------------------------------------------

    Si hayError = Falso Entonces

        Si Subcadena(texto, 0, 0) = "-" Entonces

            posicion <- 1

        FinSi

    FinSi

    // ------------------------------------------------------------
    // Recorrer todos los caracteres de la entrada
    // ------------------------------------------------------------

    Mientras posicion < longitudTexto Y hayError = Falso Hacer

        caracter <- Subcadena(texto, posicion, posicion)

        // --------------------------------------------------------
        // Verificar punto decimal
        // --------------------------------------------------------

        Si caracter = "." Entonces

            cantidadPuntos <- cantidadPuntos + 1

            Si cantidadPuntos > 1 Entonces

                hayError <- Verdadero

            FinSi

        Sino

            // ----------------------------------------------------
            // Verificar si el caracter es un digito
            // ----------------------------------------------------

            esDigito <- Falso

            Para j <- 0 Hasta 9 Hacer

                Si caracter = Subcadena(digitosValidos, j, j) Entonces

                    esDigito <- Verdadero

                FinSi

            FinPara

            Si esDigito Entonces

                cantidadDigitos <- cantidadDigitos + 1

            Sino

                hayError <- Verdadero

            FinSi

        FinSi

        posicion <- posicion + 1

    FinMientras

    // ------------------------------------------------------------
    // RESULTADO FINAL DE LA VALIDACION
    // ------------------------------------------------------------

    resultado <- hayError = Falso Y cantidadPuntos <= 1 Y cantidadDigitos > 0

FinFuncion
